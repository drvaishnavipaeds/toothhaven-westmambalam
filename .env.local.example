# Copy this file to .env.local and fill with your local development values
# .env.local is in .gitignore and will NOT be committed to GitHub

# Supabase Configuration (Development)
VITE_SUPABASE_URL=https://your-dev-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-dev-anon-key

# Payment Gateway - Razorpay (Test Key for Development)
VITE_RAZORPAY_KEY=rzp_test_SdQ7562mMWoVkM

# UPI Payment Details (Test)
VITE_UPI_ID=Q42218734@ybl
VITE_UPI_PAYEE_NAME=Tooth Haven Dental

# Admin Configuration
VITE_ADMIN_SECRET_KEY=dev-secret-key-change-in-production

# API Configuration
VITE_API_TIMEOUT_MS=30000

# Security
VITE_SESSION_TIMEOUT_MINUTES=30
VITE_ENABLE_CSRF_PROTECTION=true

# ===== WhatsApp Integration (Required for Notifications) =====
# Get these from Meta Business Platform (https://business.facebook.com/)
# WITHOUT these, appointment notifications will NOT be sent!

# Your WhatsApp Business Account Access Token
# Get from: Settings → System Users → Generate Token
WHATSAPP_ACCESS_TOKEN=your-meta-access-token-here

# Your WhatsApp Phone Number ID
# Get from: WhatsApp → Phone Numbers → Select your number → Copy ID
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id-here

# Your WhatsApp Business Account ID (WABA ID)
# Get from: WhatsApp → Getting Started → Copy Business Account ID
WHATSAPP_BUSINESS_ACCOUNT_ID=your-waba-id-here

# Your Meta App Secret (for security verification)
# Get from: Settings → Basic → App Secret
META_APP_SECRET=your-meta-app-secret-here

# Your clinic's WhatsApp number (for receiving admin notifications)
# Format: Country Code + Number (e.g., 91 + 9876543210 for India)
# This will receive appointment notifications when patients book
CLINIC_NOTIFY_PHONE=918925166149

# Default country code for normalizing phone numbers (India = 91)
DEFAULT_COUNTRY_CODE=91

# Optional: WhatsApp Template Names (if you want to use templates instead of text)
# WHATSAPP_TEMPLATE_OTP=th_otp
# WHATSAPP_TEMPLATE_APPOINTMENT=th_appointment_reminder
# WHATSAPP_TEMPLATE_PAYMENT=th_payment_receipt
# WHATSAPP_TEMPLATE_RECALL=th_recall_checkup
# WHATSAPP_TEMPLATE_LANG=en
